{
  "manifest_version": 3,
  "name": "Picky: Compare Products & See Every Detail",
  "short_name": "Picky",
  "version": "2.0.0",
  "description": "See every detail of {brands} products on one clean page. Save them and compare side by side.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "logo-16.png",
    "32": "logo-32.png",
    "48": "logo-48.png",
    "128": "logo-128.png"
  },
  "action": {
    "default_icon": {
      "16": "logo-16.png",
      "32": "logo-32.png"
    },
    "default_title": "Picky: see this product's details"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen"],
  "host_permissions": [],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "See this product's details"
    },
    "open-comparison": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Compare this product with your saved ones"
    },
    "open-cart": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open your cart"
    }
  },
  "content_scripts": [
    {
      "matches": [],
      "js": ["link-alt-click.js"],
      "run_at": "document_idle"
    }
  ]
}
