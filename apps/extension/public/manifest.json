{
  "manifest_version": 3,
  "name": "Picky: Product Spec Sheets & Compare",
  "short_name": "Picky",
  "version": "1.2.0",
  "description": "Turn Amazon.in and Flipkart product pages into clean spec sheets, save them to your Picky library, and compare.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "logo-16.png",
    "32": "logo-32.png",
    "48": "logo-48.png",
    "128": "logo-128.png"
  },
  "action": {
    "default_icon": {
      "16": "logo-16.png",
      "32": "logo-32.png"
    },
    "default_title": "Quick Look: specs of this page"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen"],
  "host_permissions": ["https://www.amazon.in/*", "https://www.flipkart.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Quick Look: specs of this page"
    },
    "open-comparison": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Quick Look: compare this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://www.flipkart.com/*"],
      "js": ["link-alt-click.js"],
      "run_at": "document_idle"
    }
  ]
}
