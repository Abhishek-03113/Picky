{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Vercel-Cache-Tag", "value": "picky-web,picky-web-assets" }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|ico|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Vercel-Cache-Tag", "value": "picky-web,picky-web-images" }
      ]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "has": [{ "type": "header", "key": "accept", "value": "(.*)text/html(.*)" }],
      "headers": [{ "key": "Vercel-Cache-Tag", "value": "picky-web,picky-web-html" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://picky-api.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
